# GPU image for Phase 6 benchmarking. Not the deploy image -- that stays
# Dockerfile (CPU, slim, mock backend). This one exists to be pulled onto a
# rented NVIDIA box and run the real model.
#
# Built by .github/workflows/gpu-image.yml on an x86 runner and pushed to
# GHCR, because building a CUDA image on an ARM Mac means emulating x86 for
# every layer.
#
# Differences from Dockerfile, each deliberate:
#   - CUDA runtime base instead of python:slim. The host supplies the driver;
#     the image supplies the CUDA libraries torch links against.
#   - torch/transformers installed (requirements-model.txt).
#   - bench/ is included. Load tests run INSIDE the pod against localhost so
#     the provider's HTTP proxy does not distort throughput measurements.
#   - BACKEND defaults to qwen.
#   - HF cache pinned to /app/hf so a mounted volume can persist the 3GB
#     model download across pod restarts.

FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HF_HOME=/app/hf \
    BACKEND=qwen \
    MODEL_DEVICE=cuda

# Ubuntu 24.04 ships Python 3.12 -- same interpreter as the CPU image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

WORKDIR /app

# torch first, on its own layer: it is the multi-GB dependency and changes
# least. Everything else after it rebuilds cheaply.
COPY requirements-model.txt ./
RUN pip install -r requirements-model.txt

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY app/ ./app/
COPY bench/ ./bench/

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/logs /app/hf /app/bench/results \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=3 \
    CMD python -c "import os,urllib.request,sys; p=os.environ.get('PORT','8000'); sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{p}/healthz', timeout=3).status == 200 else 1)"

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
